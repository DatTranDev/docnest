{
  "name": "text-editor",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "packages/editor-core",
    "apps/web",
    "tools/lint-glob"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "fast-glob": "file:../../../tools/lint-glob"
  },
  "scripts": {
    "format:write": "prettier --write \"**/*.{ts,tsx,mjs,js,cjs,json,yml,yaml,css,md,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,js,cjs,json,yml,yaml,css,md,html}\"",
    "architecture": "node checks/frontend-boundaries.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint apps/web packages/editor-core --max-warnings=0",
    "e2e": "npm run e2e --workspace apps/web",
    "benchmark": "npm run benchmark --workspace apps/web",
    "worker-check": "npm run worker-check --workspace apps/web"
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "eslint-config-next": "16.3.8",
    "eslint": "9.39.5",
    "typescript-eslint": "8.71.0"
  }
}
