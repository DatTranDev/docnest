{
  "name": "text-editor",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend/editor-core",
    "frontend/web",
    "tooling/lint-glob"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "fast-glob": "file:tooling/lint-glob",
    "vite": "8.3.5"
  },
  "scripts": {
    "dev:remote": "npm run dev:remote --workspace frontend/web",
    "format:write": "prettier --write \"**/*.{ts,tsx,mjs,js,cjs,json,yml,yaml,css,md,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,js,cjs,json,yml,yaml,css,md,html}\"",
    "architecture": "node testing/checks/frontend-boundaries.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "build:local": "npm run build:local --workspace frontend/web",
    "preview:local": "npm run preview:local --workspace frontend/web",
    "lint": "eslint frontend/web frontend/editor-core testing/benchmark --max-warnings=0",
    "benchmark": "npm run benchmark --workspace frontend/web",
    "worker-check": "npm run worker-check --workspace frontend/web"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "next": "16.4.2",
    "prettier": "3.9.9",
    "typescript-eslint": "8.71.0"
  }
}
