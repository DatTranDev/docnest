{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "DocumentVersionSaved"
    },
    "schemaVersion": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "const": "document-service"
    },
    "traceId": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "documentId": {
          "type": "string",
          "format": "uuid"
        },
        "versionId": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "ownerUserId": {
          "type": "string",
          "format": "uuid"
        },
        "actorUserId": {
          "type": "string",
          "format": "uuid"
        },
        "objectRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": {
              "enum": ["LOCAL", "GCS"]
            },
            "bucket": {
              "type": ["string", "null"],
              "maxLength": 128
            },
            "key": {
              "type": "string",
              "maxLength": 512
            },
            "generation": {
              "type": "string",
              "pattern": "^[0-9]+$",
              "maxLength": 32
            }
          },
          "required": ["provider", "bucket", "key", "generation"]
        },
        "nativeSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "nativeBytes": {
          "type": "integer",
          "minimum": 20,
          "maximum": 33554432
        },
        "textUtf8Bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10485760
        },
        "utf16Length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10485760
        },
        "logicalLines": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      },
      "required": [
        "documentId",
        "versionId",
        "revision",
        "ownerUserId",
        "actorUserId",
        "objectRef",
        "nativeSha256",
        "nativeBytes",
        "textUtf8Bytes",
        "utf16Length",
        "logicalLines"
      ]
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "producer",
    "traceId",
    "payload"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://text-editor.example/contracts/events/document.version.saved.v1.schema.json"
}
