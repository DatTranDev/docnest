{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "ConsumerDeadLetter"
    },
    "schemaVersion": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "const": "consumer-error-handler"
    },
    "traceId": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "originalTopic": {
          "type": "string",
          "maxLength": 128
        },
        "partition": {
          "type": "integer",
          "minimum": 0
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "originalKey": {
          "type": ["string", "null"],
          "maxLength": 128
        },
        "originalPayloadBase64": {
          "type": "string",
          "maxLength": 87384
        },
        "reason": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": [
        "originalTopic",
        "partition",
        "offset",
        "originalKey",
        "originalPayloadBase64",
        "reason"
      ]
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "producer",
    "traceId",
    "payload"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://text-editor.example/contracts/events/editor.dead-letter.v1.schema.json"
}
