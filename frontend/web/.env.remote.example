# Optional: copy to .env.remote.local. Shell environment variables take precedence.
REMOTE_BACKEND_ORIGIN=https://k8s.docsnest.dattrandev.id.vn
PORT=8080
NEXT_INTERNAL_PORT=3000
# Optional public OAuth client ID. Google must allow http://localhost:8080.
# Password login works without this. Never put an OAuth client secret here.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
