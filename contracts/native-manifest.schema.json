{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "textEncoding": {
      "const": "utf-8"
    },
    "internalEol": {
      "const": "LF"
    },
    "preferredExportEol": {
      "enum": ["LF", "CRLF"]
    },
    "exportBom": {
      "type": "boolean"
    },
    "offsetUnit": {
      "const": "utf16"
    },
    "utf8Bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10485760
    },
    "utf16Length": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10485760
    },
    "logicalLines": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "stylesEncoding": {
      "const": "adaptive-v1"
    },
    "textSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "stylesSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "textEncoding",
    "internalEol",
    "preferredExportEol",
    "exportBom",
    "offsetUnit",
    "utf8Bytes",
    "utf16Length",
    "logicalLines",
    "stylesEncoding",
    "textSha256",
    "stylesSha256"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://text-editor.example/contracts/native-manifest.schema.json"
}
