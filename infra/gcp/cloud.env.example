SPRING_PROFILES_ACTIVE=cloud
WEB_ORIGIN=https://YOUR_DOMAIN
JWT_ISSUER=https://YOUR_DOMAIN
JWT_AUDIENCE=editor-api
STORAGE_PROVIDER=GCS
GCS_SNAPSHOTS_BUCKET=YOUR_PRIVATE_SNAPSHOTS_BUCKET
GCS_RESULTS_BUCKET=YOUR_PRIVATE_RESULTS_BUCKET
IDENTITY_IMAGE=YOUR_REGION-docker.pkg.dev/YOUR_PROJECT/editor/identity-service@sha256:REPLACE_SHA256
DOCUMENT_IMAGE=YOUR_REGION-docker.pkg.dev/YOUR_PROJECT/editor/document-service@sha256:REPLACE_SHA256
PROCESSING_IMAGE=YOUR_REGION-docker.pkg.dev/YOUR_PROJECT/editor/processing-service@sha256:REPLACE_SHA256
WEB_IMAGE=YOUR_REGION-docker.pkg.dev/YOUR_PROJECT/editor/web@sha256:REPLACE_SHA256
SPRING_FLYWAY_ENABLED=false
# Secrets must be populated outside Git using Secret Manager.
MYSQL_ROOT_PASSWORD=SECRET_MANAGER_REFERENCE
IDENTITY_DB_PASSWORD=SECRET_MANAGER_REFERENCE
DOCUMENT_DB_PASSWORD=SECRET_MANAGER_REFERENCE
PROCESSING_DB_PASSWORD=SECRET_MANAGER_REFERENCE
DOCUMENT_INTERNAL_KEY=SECRET_MANAGER_REFERENCE
PROCESSING_INTERNAL_KEY=SECRET_MANAGER_REFERENCE
KAFKA_BROKER_PASSWORD=SECRET_MANAGER_REFERENCE
KAFKA_ADMIN_PASSWORD=SECRET_MANAGER_REFERENCE
KAFKA_DOCUMENT_PASSWORD=SECRET_MANAGER_REFERENCE
KAFKA_PROCESSING_PASSWORD=SECRET_MANAGER_REFERENCE
KAFKA_OPERATOR_PASSWORD=SECRET_MANAGER_REFERENCE
